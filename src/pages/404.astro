---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found - designcode.me"
  description="This page does not exist or has moved"
>
  <div class="archive-container">
    <h1 class="page-heading">Page not found</h1>
    <p>
      This page does not exist here. Posts from my old travel blog,
      abbyontravel.com, are moving to this site one by one, so the one you were
      looking for may not be here yet.
    </p>
    <p>
      <a href="/archive">Browse the archive</a> or
      <a href="/">go back to all posts</a>.
    </p>
  </div>
</BaseLayout>
